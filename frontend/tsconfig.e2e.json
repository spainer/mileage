{
    // Type-checks the deployment spec, which the Playwright runner otherwise
    // transpiles without type checking. The older e2e specs predate type
    // checking and are not yet strict-clean, so they stay out of scope.
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["e2e/deployment.spec.ts", "e2e/localization.spec.ts"]
}
